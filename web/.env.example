# Furnish marketing site environment variables.
# Copy to .env.local for local dev, configure in Vercel for prod.
# Per Document 9 §12.3.

# ---- Public (browser-exposed) ----

# Toggles waitlist CTA vs. App Store CTA. Set to "true" once iOS app
# ships. Activates the /app and /ios redirects per Document 4 §6.2.
NEXT_PUBLIC_APP_LAUNCHED=false

# iOS App Store URL. Used by the Get the App CTA and the /app, /ios
# redirects. Required only when NEXT_PUBLIC_APP_LAUNCHED=true.
NEXT_PUBLIC_APP_STORE_URL=

# Canonical site origin. Used in metadata, sitemap, OG tags.
NEXT_PUBLIC_SITE_URL=https://furnish.live

# Plausible analytics domain. Set to "furnish.live" in production.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=furnish.live

# Skimlinks publisher site ID. Leave UNSET until Skimlinks approves
# the publisher application. When set, the SDK loads on /blog/*
# routes only and wraps outbound retailer links automatically.
NEXT_PUBLIC_SKIMLINKS_SITE_ID=

# ---- Server-only (NEVER prefix with NEXT_PUBLIC_) ----

# Supabase project URL. Reuse the existing app's project
# (dserurqzxtuslbamwaio) or spin up a separate one for the website.
SUPABASE_URL=

# Supabase service-role key. Server-side only. Used by the waitlist
# API route to insert email signups bypassing RLS. Never expose this
# to the browser. Rotate immediately if leaked.
SUPABASE_SERVICE_ROLE_KEY=
